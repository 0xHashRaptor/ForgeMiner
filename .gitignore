# Editing backups. These are made by the release tooling before it rewrites a file; four of them
# reached the public repo once and showed up as clutter in the file listing.
*.pre*
*.bak
*.orig
*.tmp

# Staging that lives beside the two READMEs but is not part of them. release_assets/ holds
# release-note drafts (the ones in there date from 1.1.2); nothing in this repo references them,
# and a git add -A would have published them as if they were current documentation.
/release_assets/
